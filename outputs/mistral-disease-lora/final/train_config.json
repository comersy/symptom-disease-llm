{
  "model_name": "models/mistral-7b-instruct-v0.3",
  "data_dir": "data/dataset",
  "output_dir": "outputs/mistral-disease-lora",
  "use_4bit": true,
  "bnb_4bit_compute_dtype": "bfloat16",
  "bnb_4bit_quant_type": "nf4",
  "use_nested_quant": true,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "max_seq_length": 512,
  "num_train_epochs": 5,
  "per_device_train_batch_size": 4,
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 2,
  "learning_rate": 1e-06,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
  "weight_decay": 0.01,
  "max_grad_norm": 0.3,
  "bf16": true,
  "fp16": false,
  "logging_steps": 10,
  "eval_steps": 50,
  "save_steps": 100,
  "save_total_limit": 3,
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",
  "seed": 42,
  "report_to": "none"
}